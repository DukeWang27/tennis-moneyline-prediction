+from __future__ import annotations
+
+import sqlite3
+from contextlib import contextmanager
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Iterator
+
+from rapidfuzz import fuzz, process
+
+from tennis_predictor.data.names import normalize_name
+
+
+def _utc_now() -> str:
+    return datetime.now(timezone.utc).isoformat(timespec="seconds")
+
+
+@contextmanager
+def _connection(path: str | Path) -> Iterator[sqlite3.Connection]:
+    db_path = Path(path)
+    db_path.parent.mkdir(parents=True, exist_ok=True)
+    connection = sqlite3.connect(db_path, timeout=30)
+    connection.row_factory = sqlite3.Row
+    connection.execute("PRAGMA journal_mode = WAL")
+    connection.execute("PRAGMA foreign_keys = ON")
+    try:
+        yield connection
+        connection.commit()
+    except Exception:
+        connection.rollback()
+        raise
+    finally:
+        connection.close()
+
+
+def initialize_identity_store(path: str | Path) -> Path:
+    """Create the immutable API-Tennis-ID-first identity registry."""
+    db_path = Path(path)
+    with _connection(db_path) as connection:
+        connection.executescript(
+            """
+            CREATE TABLE IF NOT EXISTS players (
+                provider_player_id INTEGER PRIMARY KEY,
+                canonical_name TEXT NOT NULL,
+                normalized_name TEXT NOT NULL,
+                dob TEXT,
+                nationality TEXT,
+                tour TEXT NOT NULL,
+                source_updated_at TEXT,
+                created_at TEXT NOT NULL,
+                updated_at TEXT NOT NULL
+            );
+
+            CREATE INDEX IF NOT EXISTS idx_players_normalized_name
+                ON players(normalized_name, tour);
+
+            CREATE TABLE IF NOT EXISTS player_aliases (
+                alias_name TEXT PRIMARY KEY,
+                display_alias TEXT NOT NULL,
+                provider_player_id INTEGER NOT NULL,
+                source TEXT NOT NULL,
+                confidence REAL,
+                verified INTEGER NOT NULL DEFAULT 0,
+                created_at TEXT NOT NULL,
+                FOREIGN KEY(provider_player_id) REFERENCES players(provider_player_id)
+            );
+
+            CREATE INDEX IF NOT EXISTS idx_player_aliases_player
+                ON player_aliases(provider_player_id);
+
+            CREATE TABLE IF NOT EXISTS source_player_ids (
+                source TEXT NOT NULL,
+                source_player_id TEXT NOT NULL,
+                provider_player_id INTEGER NOT NULL,
+                created_at TEXT NOT NULL,
+                PRIMARY KEY(source, source_player_id),
+                FOREIGN KEY(provider_player_id) REFERENCES players(provider_player_id)
+            );
+
+            CREATE TABLE IF NOT EXISTS alias_review_queue (
+                review_id INTEGER PRIMARY KEY AUTOINCREMENT,
+                source TEXT NOT NULL,
+                raw_name TEXT NOT NULL,
+                normalized_name TEXT NOT NULL,
+                tour TEXT NOT NULL,
+                suggested_player_id INTEGER,
+                suggested_name TEXT,
+                fuzzy_score REAL,
+                status TEXT NOT NULL DEFAULT 'PENDING',
+                created_at TEXT NOT NULL,
+                resolved_at TEXT,
+                UNIQUE(source, normalized_name, tour, status)
+            );
+
+            CREATE INDEX IF NOT EXISTS idx_alias_review_status
+                ON alias_review_queue(status, created_at);
+
+            CREATE TABLE IF NOT EXISTS tournament_registry (
+                provider TEXT NOT NULL,
+                provider_tournament_id TEXT NOT NULL,
+                canonical_name TEXT NOT NULL,
+                normalized_name TEXT NOT NULL,
+                tour TEXT NOT NULL,
+                surface TEXT NOT NULL DEFAULT 'Unknown',
+                tier TEXT NOT NULL,
+                source_updated_at TEXT,
+                created_at TEXT NOT NULL,
+                updated_at TEXT NOT NULL,
+                PRIMARY KEY(provider, provider_tournament_id, tour)
+            );
+
+            CREATE INDEX IF NOT EXISTS idx_tournament_registry_name
+                ON tournament_registry(provider, normalized_name, tour);
+            """
+        )
+    return db_path
+
+
+@dataclass(frozen=True, slots=True)
+class IdentityResolution:
+    provider_player_id: int | None
+    canonical_name: str | None
+    status: str
+    score: float | None = None
+    review_id: int | None = None
+
+    @property
+    def resolved(self) -> bool:
+        return self.provider_player_id is not None and self.status in {
+            "EXACT_ID",
+            "EXACT_ALIAS",
+            "EXACT_NAME",
+            "FUZZY_AUTO",
+        }
+
+
+class IdentityStore:
+    """Persistent player/tournament registry keyed by API-Tennis player IDs."""
+
+    def __init__(self, path: str | Path):
+        self.path = initialize_identity_store(path)
+
+    @staticmethod
+    def model_player_id(provider_player_id: int | str) -> str:
+        return f"api_tennis:{int(provider_player_id)}"
+
+    @staticmethod
+    def compatible_tours(tour: str) -> set[str]:
+        value = str(tour or "").upper()
+        if value == "ATP":
+            return {"ATP", "ITF_M"}
+        if value == "ITF_M":
+            return {"ITF_M", "ATP"}
+        if value == "WTA":
+            return {"WTA", "ITF_W"}
+        if value == "ITF_W":
+            return {"ITF_W", "WTA"}
+        return {value} if value else set()
+
+    def upsert_player(
+        self,
+        provider_player_id: int | str,
+        *,
+        canonical_name: str,
+        tour: str,
+        dob: str | None = None,
+        nationality: str | None = None,
+        source_updated_at: str | None = None,
+        aliases: list[str] | None = None,
+    ) -> int:
+        player_id = int(provider_player_id)
+        canonical_name = str(canonical_name).strip()
+        if not canonical_name:
+            raise ValueError("canonical_name cannot be blank")
+        tour = str(tour or "").upper()
+        now = _utc_now()
+        with _connection(self.path) as connection:
+            connection.execute(
+                """
+                INSERT INTO players(
+                    provider_player_id, canonical_name, normalized_name, dob,
+                    nationality, tour, source_updated_at, created_at, updated_at
+                ) VALUES (?,?,?,?,?,?,?,?,?)
+                ON CONFLICT(provider_player_id) DO UPDATE SET
+                    canonical_name=CASE
+                        WHEN length(excluded.canonical_name) > length(players.canonical_name)
+                        THEN excluded.canonical_name ELSE players.canonical_name END,
+                    normalized_name=CASE
+                        WHEN length(excluded.canonical_name) > length(players.canonical_name)
+                        THEN excluded.normalized_name ELSE players.normalized_name END,
+                    dob=COALESCE(excluded.dob, players.dob),
+                    nationality=COALESCE(excluded.nationality, players.nationality),
+                    tour=CASE WHEN players.tour = '' THEN excluded.tour ELSE players.tour END,
+                    source_updated_at=COALESCE(excluded.source_updated_at, players.source_updated_at),
+                    updated_at=excluded.updated_at
+                """,
+                (
+                    player_id,
+                    canonical_name,
+                    normalize_name(canonical_name),
+                    dob,
+                    nationality,
+                    tour,
+                    source_updated_at,
+                    now,
+                    now,
+                ),
+            )
+        self.add_alias(
+            canonical_name,
+            player_id,
+            source="api_tennis",
+            confidence=100.0,
+            verified=True,
+            queue_conflict=False,
+        )
+        for alias in aliases or []:
+            self.add_alias(
+                alias,
+                player_id,
+                source="api_tennis",
+                confidence=100.0,
+                verified=True,
+                queue_conflict=False,
+            )
+        return player_id
+
+    def add_alias(
+        self,
+        alias_name: str,
+        provider_player_id: int | str,
+        *,
+        source: str,
+        confidence: float | None = None,
+        verified: bool = False,
+        queue_conflict: bool = True,
+    ) -> bool:
+        alias_key = normalize_name(alias_name)
+        if not alias_key:
+            return False
+        player_id = int(provider_player_id)
+        with _connection(self.path) as connection:
+            existing = connection.execute(
+                "SELECT provider_player_id FROM player_aliases WHERE alias_name = ?",
+                (alias_key,),
+            ).fetchone()
+            if existing is not None and int(existing["provider_player_id"]) != player_id:
+                if queue_conflict:
+                    player = connection.execute(
+                        "SELECT canonical_name, tour FROM players WHERE provider_player_id = ?",
+                        (player_id,),
+                    ).fetchone()
+                    self._queue_review_connection(
+                        connection,
+                        source=source,
+                        raw_name=alias_name,
+                        tour=str(player["tour"] if player else ""),
+                        suggested_player_id=player_id,
+                        suggested_name=str(player["canonical_name"] if player else ""),
+                        score=confidence,
+                    )
+                return False
+            connection.execute(
+                """
+                INSERT INTO player_aliases(
+                    alias_name, display_alias, provider_player_id, source,
+                    confidence, verified, created_at
+                ) VALUES (?,?,?,?,?,?,?)
+                ON CONFLICT(alias_name) DO UPDATE SET
+                    display_alias=excluded.display_alias,
+                    source=excluded.source,
+                    confidence=COALESCE(excluded.confidence, player_aliases.confidence),
+                    verified=MAX(player_aliases.verified, excluded.verified)
+                """,
+                (
+                    alias_key,
+                    str(alias_name).strip(),
+                    player_id,
+                    str(source),
+                    confidence,
+                    int(bool(verified)),
+                    _utc_now(),
+                ),
+            )
+        return True
+
+    def link_source_id(
+        self,
+        *,
+        source: str,
+        source_player_id: str | int,
+        provider_player_id: str | int,
+    ) -> None:
+        with _connection(self.path) as connection:
+            connection.execute(
+                """
+                INSERT INTO source_player_ids(source, source_player_id, provider_player_id, created_at)
+                VALUES (?,?,?,?)
+                ON CONFLICT(source, source_player_id) DO UPDATE SET
+                    provider_player_id=excluded.provider_player_id
+                """,
+                (str(source), str(source_player_id), int(provider_player_id), _utc_now()),
+            )
+
+    def resolve_source_id(self, *, source: str, source_player_id: str | int) -> IdentityResolution:
+        with _connection(self.path) as connection:
+            row = connection.execute(
+                """
+                SELECT p.provider_player_id, p.canonical_name
+                FROM source_player_ids s
+                JOIN players p ON p.provider_player_id = s.provider_player_id
+                WHERE s.source = ? AND s.source_player_id = ?
+                """,
+                (str(source), str(source_player_id)),
+            ).fetchone()
+        if row is None:
+            return IdentityResolution(None, None, "UNRESOLVED")
+        return IdentityResolution(
+            int(row["provider_player_id"]), str(row["canonical_name"]), "EXACT_ID", 100.0
+        )
+
+    def resolve_name(
+        self,
+        raw_name: str,
+        *,
+        source: str,
+        tour: str,
+        fuzzy_threshold: float = 96.0,
+        minimum_margin: float = 3.0,
+        queue_unresolved: bool = True,
+    ) -> IdentityResolution:
+        normalized = normalize_name(raw_name)
+        if not normalized:
+            return IdentityResolution(None, None, "UNRESOLVED")
+        tour = str(tour or "").upper()
+        compatible_tours = self.compatible_tours(tour)
+        with _connection(self.path) as connection:
+            alias = connection.execute(
+                """
+                SELECT p.provider_player_id, p.canonical_name, p.tour
+                FROM player_aliases a
+                JOIN players p ON p.provider_player_id = a.provider_player_id
+                WHERE a.alias_name = ?
+                """,
+                (normalized,),
+            ).fetchall()
+            if compatible_tours:
+                alias = [row for row in alias if str(row["tour"]) in compatible_tours]
+            if len(alias) == 1:
+                row = alias[0]
+                return IdentityResolution(
+                    int(row["provider_player_id"]), str(row["canonical_name"]), "EXACT_ALIAS", 100.0
+                )
+
+            exact_name = connection.execute(
+                """
+                SELECT provider_player_id, canonical_name, tour
+                FROM players
+                WHERE normalized_name = ?
+                """,
+                (normalized,),
+            ).fetchall()
+            if compatible_tours:
+                exact_name = [row for row in exact_name if str(row["tour"]) in compatible_tours]
+            if len(exact_name) == 1:
+                row = exact_name[0]
+                return IdentityResolution(
+                    int(row["provider_player_id"]), str(row["canonical_name"]), "EXACT_NAME", 100.0
+                )
+
+            rows = connection.execute(
+                """
+                SELECT provider_player_id, canonical_name, normalized_name, tour
+                FROM players
+                """
+            ).fetchall()
+            if compatible_tours:
+                rows = [row for row in rows if str(row["tour"]) in compatible_tours]
+            choices = {
+                f"{int(row['provider_player_id'])}:{str(row['normalized_name'])}": row
+                for row in rows
+            }
+            ranked = process.extract(
+                normalized,
+                list(choices),
+                scorer=lambda query, choice, **_: fuzz.WRatio(query, choice.split(":", 1)[1]),
+                limit=2,
+            )
+            best_row = None
+            best_score = None
+            second_score = None
+            if ranked:
+                best_key, best_score, _ = ranked[0]
+                best_row = choices[best_key]
+                second_score = ranked[1][1] if len(ranked) > 1 else 0.0
+            if (
+                best_row is not None
+                and float(best_score) >= float(fuzzy_threshold)
+                and float(best_score) - float(second_score or 0.0) >= float(minimum_margin)
+            ):
+                player_id = int(best_row["provider_player_id"])
+                canonical_name = str(best_row["canonical_name"])
+                connection.execute(
+                    """
+                    INSERT INTO player_aliases(
+                        alias_name, display_alias, provider_player_id, source,
+                        confidence, verified, created_at
+                    ) VALUES (?,?,?,?,?,?,?)
+                    ON CONFLICT(alias_name) DO NOTHING
+                    """,
+                    (
+                        normalized,
+                        str(raw_name).strip(),
+                        player_id,
+                        str(source),
+                        float(best_score),
+                        0,
+                        _utc_now(),
+                    ),
+                )
+                return IdentityResolution(
+                    player_id, canonical_name, "FUZZY_AUTO", float(best_score)
+                )
+
+            review_id = None
+            if queue_unresolved:
+                review_id = self._queue_review_connection(
+                    connection,
+                    source=source,
+                    raw_name=raw_name,
+                    tour=tour,
+                    suggested_player_id=(int(best_row["provider_player_id"]) if best_row else None),
+                    suggested_name=(str(best_row["canonical_name"]) if best_row else None),
+                    score=(float(best_score) if best_score is not None else None),
+                )
+        return IdentityResolution(
+            None,
+            None,
+            "REVIEW_REQUIRED" if queue_unresolved else "UNRESOLVED",
+            float(best_score) if best_score is not None else None,
+            review_id,
+        )
+
+    def _queue_review_connection(
+        self,
+        connection: sqlite3.Connection,
+        *,
+        source: str,
+        raw_name: str,
+        tour: str,
+        suggested_player_id: int | None,
+        suggested_name: str | None,
+        score: float | None,
+    ) -> int:
+        normalized = normalize_name(raw_name)
+        connection.execute(
+            """
+            INSERT INTO alias_review_queue(
+                source, raw_name, normalized_name, tour, suggested_player_id,
+                suggested_name, fuzzy_score, status, created_at
+            ) VALUES (?,?,?,?,?,?,?,?,?)
+            ON CONFLICT(source, normalized_name, tour, status) DO UPDATE SET
+                raw_name=excluded.raw_name,
+                suggested_player_id=excluded.suggested_player_id,
+                suggested_name=excluded.suggested_name,
+                fuzzy_score=excluded.fuzzy_score
+            """,
+            (
+                str(source),
+                str(raw_name).strip(),
+                normalized,
+                str(tour or "").upper(),
+                suggested_player_id,
+                suggested_name,
+                score,
+                "PENDING",
+                _utc_now(),
+            ),
+        )
+        row = connection.execute(
+            """
+            SELECT review_id FROM alias_review_queue
+            WHERE source = ? AND normalized_name = ? AND tour = ? AND status = 'PENDING'
+            """,
+            (str(source), normalized, str(tour or "").upper()),
+        ).fetchone()
+        return int(row["review_id"])
+
+    def pending_reviews(self, *, limit: int = 200) -> list[dict]:
+        with _connection(self.path) as connection:
+            rows = connection.execute(
+                """
+                SELECT * FROM alias_review_queue
+                WHERE status = 'PENDING'
+                ORDER BY created_at, review_id
+                LIMIT ?
+                """,
+                (int(limit),),
+            ).fetchall()
+        return [dict(row) for row in rows]
+
+    def resolve_review(self, review_id: int, provider_player_id: int) -> None:
+        with _connection(self.path) as connection:
+            review = connection.execute(
+                "SELECT * FROM alias_review_queue WHERE review_id = ?",
+                (int(review_id),),
+            ).fetchone()
+            if review is None:
+                raise KeyError(f"Unknown alias review id {review_id}")
+            player = connection.execute(
+                "SELECT canonical_name FROM players WHERE provider_player_id = ?",
+                (int(provider_player_id),),
+            ).fetchone()
+            if player is None:
+                raise KeyError(f"Unknown provider player id {provider_player_id}")
+            alias_key = normalize_name(str(review["raw_name"]))
+            existing = connection.execute(
+                "SELECT provider_player_id FROM player_aliases WHERE alias_name = ?",
+                (alias_key,),
+            ).fetchone()
+            if existing is not None and int(existing["provider_player_id"]) != int(provider_player_id):
+                raise ValueError("Alias is already assigned to a different player")
+            connection.execute(
+                """
+                INSERT INTO player_aliases(
+                    alias_name, display_alias, provider_player_id, source,
+                    confidence, verified, created_at
+                ) VALUES (?,?,?,?,?,?,?)
+                ON CONFLICT(alias_name) DO UPDATE SET
+                    provider_player_id=excluded.provider_player_id,
+                    source=excluded.source,
+                    confidence=excluded.confidence,
+                    verified=1
+                """,
+                (
+                    alias_key,
+                    str(review["raw_name"]),
+                    int(provider_player_id),
+                    str(review["source"]),
+                    100.0,
+                    1,
+                    _utc_now(),
+                ),
+            )
+            connection.execute(
+                """
+                UPDATE alias_review_queue
+                SET status = 'RESOLVED', resolved_at = ?,
+                    suggested_player_id = ?, suggested_name = ?, fuzzy_score = 100.0
+                WHERE review_id = ?
+                """,
+                (_utc_now(), int(provider_player_id), str(player["canonical_name"]), int(review_id)),
+            )
+
+    def search_players(self, query: str = "", *, tour: str = "", limit: int = 50) -> list[dict]:
+        normalized = normalize_name(query)
+        compatible_tours = self.compatible_tours(tour)
+        with _connection(self.path) as connection:
+            rows = connection.execute(
+                """
+                SELECT provider_player_id, canonical_name, normalized_name, dob, nationality, tour
+                FROM players
+                ORDER BY canonical_name
+                """
+            ).fetchall()
+        output = []
+        for row in rows:
+            if compatible_tours and str(row["tour"]) not in compatible_tours:
+                continue
+            if normalized and normalized not in str(row["normalized_name"]):
+                continue
+            data = dict(row)
+            data.pop("normalized_name", None)
+            output.append(data)
+            if len(output) >= int(limit):
+                break
+        return output
+
+    def player_frame(self) -> list[dict]:
+        with _connection(self.path) as connection:
+            rows = connection.execute(
+                """
+                SELECT provider_player_id, canonical_name, normalized_name,
+                       dob, nationality, tour
+                FROM players
+                ORDER BY provider_player_id
+                """
+            ).fetchall()
+        return [dict(row) for row in rows]
+
+    def upsert_tournament(
+        self,
+        *,
+        provider: str,
+        provider_tournament_id: str | int,
+        canonical_name: str,
+        tour: str,
+        surface: str,
+        tier: str,
+        source_updated_at: str | None = None,
+    ) -> None:
+        surface = str(surface or "Unknown").title()
+        if surface not in {"Hard", "Clay", "Grass", "Carpet", "Unknown"}:
+            surface = "Unknown"
+        now = _utc_now()
+        with _connection(self.path) as connection:
+            connection.execute(
+                """
+                INSERT INTO tournament_registry(
+                    provider, provider_tournament_id, canonical_name,
+                    normalized_name, tour, surface, tier, source_updated_at,
+                    created_at, updated_at
+                ) VALUES (?,?,?,?,?,?,?,?,?,?)
+                ON CONFLICT(provider, provider_tournament_id, tour) DO UPDATE SET
+                    canonical_name=excluded.canonical_name,
+                    normalized_name=excluded.normalized_name,
+                    surface=CASE WHEN excluded.surface = 'Unknown'
+                                 THEN tournament_registry.surface ELSE excluded.surface END,
+                    tier=excluded.tier,
+                    source_updated_at=COALESCE(excluded.source_updated_at, tournament_registry.source_updated_at),
+                    updated_at=excluded.updated_at
+                """,
+                (
+                    str(provider),
+                    str(provider_tournament_id),
+                    str(canonical_name),
+                    normalize_name(canonical_name),
+                    str(tour or "").upper(),
+                    surface,
+                    str(tier),
+                    source_updated_at,
+                    now,
+                    now,
+                ),
+            )
+
+    def resolve_tournament(
+        self,
+        *,
+        provider: str,
+        provider_tournament_id: str | int,
+        tournament_name: str,
+        tour: str,
+    ) -> dict[str, str] | None:
+        with _connection(self.path) as connection:
+            row = connection.execute(
+                """
+                SELECT surface, tier, canonical_name
+                FROM tournament_registry
+                WHERE provider = ? AND provider_tournament_id = ? AND tour = ?
+                """,
+                (str(provider), str(provider_tournament_id), str(tour or "").upper()),
+            ).fetchone()
+            if row is None:
+                row = connection.execute(
+                    """
+                    SELECT surface, tier, canonical_name
+                    FROM tournament_registry
+                    WHERE provider = ? AND normalized_name = ? AND tour = ?
+                    ORDER BY updated_at DESC LIMIT 1
+                    """,
+                    (str(provider), normalize_name(tournament_name), str(tour or "").upper()),
+                ).fetchone()
+        return dict(row) if row is not None else None
