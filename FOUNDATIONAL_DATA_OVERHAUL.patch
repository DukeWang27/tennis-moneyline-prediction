+from __future__ import annotations
+
+import json
+import shutil
+from dataclasses import asdict, dataclass
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import pandas as pd
+
+from tennis_predictor.backtest import WalkForwardBacktester
+from tennis_predictor.backtest.metrics import calibration_curve_table, evaluate_predictions
+from tennis_predictor.config import AppConfig
+from tennis_predictor.data import OddsAligner, TennisDataLoader, load_normalized_snapshots
+from tennis_predictor.data.names import normalize_name
+from tennis_predictor.features import FeatureEngineer
+from tennis_predictor.filters import FilterEngine
+from tennis_predictor.pipeline import TennisPredictionSystem
+from tennis_predictor.storage.identity_store import IdentityStore
+
+
+_SOURCE_PRIORITY = {
+    "api_tennis": 30,
+    "api_tennis_archive": 30,
+    "sackmann": 20,
+    "tennis_data": 10,
+}
+_REQUIRED_GATE_SEGMENTS = ("ATP_CHALLENGER", "ITF_MEN", "ITF_WOMEN")
+
+
+def derive_competition_segment(frame: pd.DataFrame) -> pd.Series:
+    tour = frame.get("tour", pd.Series("", index=frame.index)).astype(str).str.upper()
+    tier = frame.get("tier", pd.Series("", index=frame.index)).astype(str).str.casefold()
+    existing = frame.get("competition_segment", pd.Series("", index=frame.index)).astype(str)
+    result = existing.where(existing.ne(""), "OTHER")
+    result = result.mask(tour.eq("ATP") & tier.eq("challenger"), "ATP_CHALLENGER")
+    result = result.mask(tour.eq("ATP") & tier.eq("itf"), "ITF_MEN")
+    result = result.mask(tour.eq("WTA") & tier.eq("itf"), "ITF_WOMEN")
+    result = result.mask(tour.eq("ATP") & result.eq("OTHER"), "ATP_MAIN")
+    result = result.mask(tour.eq("WTA") & result.eq("OTHER"), "WTA_MAIN")
+    return result
+
+
+def _stable_seconds(value: str) -> int:
+    return sum(ord(char) for char in value) % 86_400
+
+
+def chronology_timestamp(frame: pd.DataFrame) -> pd.Series:
+    date_values = pd.to_datetime(frame["date"], errors="coerce")
+    if "commence_time" in frame:
+        commence = pd.to_datetime(frame["commence_time"], errors="coerce")
+    else:
+        commence = pd.Series(pd.NaT, index=frame.index, dtype="datetime64[ns]")
+    fallback = date_values.dt.normalize() + pd.to_timedelta(
+        frame["match_id"].astype(str).map(_stable_seconds), unit="s"
+    )
+    return commence.fillna(fallback)
+
+
+@dataclass(slots=True)
+class AssemblyReport:
+    input_rows: int
+    canonical_rows: int
+    unresolved_rows: int
+    duplicate_rows_removed: int
+    output_rows: int
+    by_source: dict[str, int]
+    by_segment: dict[str, int]
+
+    def to_dict(self) -> dict[str, Any]:
+        return asdict(self)
+
+
+class MultiSourceMatchAssembler:
+    """Canonicalize all match sources into API-Tennis player IDs."""
+
+    def __init__(self, identity_store: IdentityStore, *, fuzzy_threshold: float = 96.0):
+        self.identity_store = identity_store
+        self.fuzzy_threshold = float(fuzzy_threshold)
+
+    def _resolve_side(
+        self,
+        frame: pd.DataFrame,
+        *,
+        side: str,
+        source: str,
+    ) -> tuple[pd.Series, pd.Series, pd.Series]:
+        names = frame[side].fillna("").astype(str)
+        tours = frame.get("tour", pd.Series("", index=frame.index)).fillna("").astype(str)
+        source_ids = frame.get(f"{side}_provider_id")
+        if source_ids is None:
+            source_ids = frame.get(f"{side}_id", pd.Series("", index=frame.index))
+
+        resolved_ids = pd.Series(pd.NA, index=frame.index, dtype="Int64")
+        canonical_names = pd.Series(pd.NA, index=frame.index, dtype="string")
+        statuses = pd.Series("UNRESOLVED", index=frame.index, dtype="string")
+
+        cache: dict[tuple[str, str, str], tuple[int | None, str | None, str]] = {}
+        for index in frame.index:
+            raw_name = names.loc[index]
+            tour = tours.loc[index].upper()
+            raw_source_id = source_ids.loc[index] if index in source_ids.index else ""
+            key = (str(raw_source_id), normalize_name(raw_name), tour)
+            cached = cache.get(key)
+            if cached is None:
+                resolution = None
+                if source == "api_tennis" and str(raw_source_id).strip().isdigit():
+                    source_resolution = self.identity_store.resolve_source_id(
+                        source="api_tennis",
+                        source_player_id=str(raw_source_id).strip(),
+                    )
+                    if source_resolution.resolved:
+                        resolution = (
+                            source_resolution.provider_player_id,
+                            source_resolution.canonical_name,
+                            source_resolution.status,
+                        )
+                elif str(raw_source_id).strip():
+                    source_resolution = self.identity_store.resolve_source_id(
+                        source=source,
+                        source_player_id=str(raw_source_id),
+                    )
+                    if source_resolution.resolved:
+                        resolution = (
+                            source_resolution.provider_player_id,
+                            source_resolution.canonical_name,
+                            source_resolution.status,
+                        )
+
+                if resolution is None:
+                    name_resolution = self.identity_store.resolve_name(
+                        raw_name,
+                        source=source,
+                        tour=tour,
+                        fuzzy_threshold=self.fuzzy_threshold,
+                        queue_unresolved=True,
+                    )
+                    resolution = (
+                        name_resolution.provider_player_id,
+                        name_resolution.canonical_name,
+                        name_resolution.status,
+                    )
+                    if name_resolution.resolved and str(raw_source_id).strip():
+                        self.identity_store.link_source_id(
+                            source=source,
+                            source_player_id=str(raw_source_id),
+                            provider_player_id=int(name_resolution.provider_player_id),
+                        )
+                cache[key] = resolution
+                cached = resolution
+
+            player_id, canonical_name, status = cached
+            if player_id is not None:
+                resolved_ids.loc[index] = int(player_id)
+                canonical_names.loc[index] = str(canonical_name)
+            statuses.loc[index] = status
+        return resolved_ids, canonical_names, statuses
+
+    @staticmethod
+    def _source_name(frame: pd.DataFrame, default: str) -> pd.Series:
+        if "source" in frame:
+            source = frame["source"].fillna("").astype(str)
+        elif "source_file" in frame:
+            source = frame["source_file"].fillna("").astype(str)
+        else:
+            source = pd.Series(default, index=frame.index)
+        normalized = source.str.casefold()
+        return pd.Series(
+            np.select(
+                [
+                    normalized.str.contains("api_tennis"),
+                    normalized.str.contains("sackmann") | normalized.str.contains("atp_matches") | normalized.str.contains("wta_matches"),
+                    normalized.str.contains("tennis_data"),
+                ],
+                ["api_tennis", "sackmann", "tennis_data"],
+                default=default,
+            ),
+            index=frame.index,
+        )
+
+    def canonicalize(self, frame: pd.DataFrame, *, default_source: str) -> tuple[pd.DataFrame, pd.DataFrame]:
+        if frame is None or frame.empty:
+            return pd.DataFrame(), pd.DataFrame()
+        output = frame.copy()
+        output["source"] = self._source_name(output, default_source)
+        resolved_parts: list[pd.DataFrame] = []
+        unresolved_parts: list[pd.DataFrame] = []
+        for source, group in output.groupby("source", sort=False):
+            group = group.copy()
+            p1_id, p1_name, p1_status = self._resolve_side(group, side="player1", source=str(source))
+            p2_id, p2_name, p2_status = self._resolve_side(group, side="player2", source=str(source))
+            group["player1_provider_id"] = p1_id
+            group["player2_provider_id"] = p2_id
+            group["identity_status1"] = p1_status
+            group["identity_status2"] = p2_status
+            group["identity_resolved"] = p1_id.notna() & p2_id.notna()
+            group.loc[p1_name.notna(), "player1"] = p1_name[p1_name.notna()]
+            group.loc[p2_name.notna(), "player2"] = p2_name[p2_name.notna()]
+            group["player1_id"] = p1_id.map(
+                lambda value: self.identity_store.model_player_id(value) if pd.notna(value) else pd.NA
+            )
+            group["player2_id"] = p2_id.map(
+                lambda value: self.identity_store.model_player_id(value) if pd.notna(value) else pd.NA
+            )
+            resolved_parts.append(group[group["identity_resolved"]].copy())
+            rejected = group[~group["identity_resolved"]].copy()
+            if not rejected.empty:
+                rejected["unresolved_reason"] = (
+                    "player1=" + rejected["identity_status1"].astype(str)
+                    + "; player2=" + rejected["identity_status2"].astype(str)
+                )
+                unresolved_parts.append(rejected)
+        resolved = pd.concat(resolved_parts, ignore_index=True) if resolved_parts else pd.DataFrame()
+        unresolved = pd.concat(unresolved_parts, ignore_index=True) if unresolved_parts else pd.DataFrame()
+        return resolved, unresolved
+
+    @staticmethod
+    def _dedupe_key(row: pd.Series) -> str:
+        provider_event = str(row.get("provider_event_id") or "").strip()
+        source = str(row.get("source") or "")
+        if source == "api_tennis" and provider_event:
+            return f"api_tennis:{provider_event}"
+        players = sorted(
+            [str(int(row["player1_provider_id"])), str(int(row["player2_provider_id"]))]
+        )
+        date_value = pd.Timestamp(row["date"]).date().isoformat()
+        return "|".join(
+            [
+                date_value,
+                str(row.get("tour") or ""),
+                normalize_name(str(row.get("tournament") or "")),
+                str(row.get("round") or ""),
+                players[0],
+                players[1],
+            ]
+        )
+
+    def assemble(
+        self,
+        sources: list[tuple[pd.DataFrame, str]],
+        *,
+        start_date: object,
+        end_date: object | None = None,
+    ) -> tuple[pd.DataFrame, pd.DataFrame, AssemblyReport]:
+        canonical: list[pd.DataFrame] = []
+        unresolved: list[pd.DataFrame] = []
+        input_rows = 0
+        for frame, default_source in sources:
+            if frame is None or frame.empty:
+                continue
+            input_rows += len(frame)
+            resolved, rejected = self.canonicalize(frame, default_source=default_source)
+            if not resolved.empty:
+                canonical.append(resolved)
+            if not rejected.empty:
+                unresolved.append(rejected)
+        combined = pd.concat(canonical, ignore_index=True) if canonical else pd.DataFrame()
+        unresolved_frame = pd.concat(unresolved, ignore_index=True) if unresolved else pd.DataFrame()
+        if combined.empty:
+            report = AssemblyReport(input_rows, 0, len(unresolved_frame), 0, 0, {}, {})
+            return combined, unresolved_frame, report
+
+        combined["date"] = pd.to_datetime(combined["date"], errors="coerce")
+        combined = combined.dropna(subset=["date", "player1_won"]).copy()
+        start = pd.Timestamp(start_date).normalize()
+        end = pd.Timestamp(end_date).normalize() if end_date is not None else combined["date"].max()
+        combined = combined[combined["date"].between(start, end)].copy()
+        combined["surface"] = combined.get("surface", "Unknown").fillna("Unknown").astype(str).str.title()
+        combined.loc[~combined["surface"].isin({"Hard", "Clay", "Grass", "Carpet"}), "surface"] = "Unknown"
+        combined["surface_known"] = combined["surface"].isin({"Hard", "Clay", "Grass", "Carpet"})
+        combined["competition_segment"] = derive_competition_segment(combined)
+        combined["chronology_ts"] = chronology_timestamp(combined)
+        combined["event_date"] = pd.to_datetime(
+            combined.get("event_date", combined["date"]), errors="coerce"
+        ).fillna(combined["date"])
+        combined["date_is_estimated"] = combined.get("date_is_estimated", False).fillna(False).astype(bool)
+        combined["match_num"] = pd.to_numeric(combined.get("match_num", 0), errors="coerce").fillna(0).astype(int)
+        combined["retirement"] = combined.get("retirement", False).fillna(False).astype(bool)
+        combined["walkover"] = combined.get("walkover", False).fillna(False).astype(bool)
+        combined["defaulted"] = combined.get("defaulted", False).fillna(False).astype(bool)
+        combined["void"] = combined.get("void", False).fillna(False).astype(bool)
+        combined["game_form_eligible"] = combined.get(
+            "game_form_eligible",
+            ~(combined["retirement"] | combined["walkover"] | combined["defaulted"] | combined["void"]),
+        ).fillna(False).astype(bool)
+        combined["source_priority"] = combined["source"].map(_SOURCE_PRIORITY).fillna(0).astype(int)
+        combined["dedupe_key"] = combined.apply(self._dedupe_key, axis=1)
+        before = len(combined)
+        combined = (
+            combined.sort_values(
+                ["source_priority", "chronology_ts", "match_id"],
+                ascending=[False, True, True],
+            )
+            .drop_duplicates("dedupe_key", keep="first")
+            .sort_values(["chronology_ts", "match_id"])
+            .reset_index(drop=True)
+        )
+        duplicates = before - len(combined)
+        combined = combined.drop(columns=["source_priority", "dedupe_key"], errors="ignore")
+        report = AssemblyReport(
+            input_rows=input_rows,
+            canonical_rows=before,
+            unresolved_rows=len(unresolved_frame),
+            duplicate_rows_removed=duplicates,
+            output_rows=len(combined),
+            by_source=combined["source"].value_counts().astype(int).to_dict(),
+            by_segment=combined["competition_segment"].value_counts().astype(int).to_dict(),
+        )
+        return combined, unresolved_frame, report
+
+
+@dataclass(slots=True)
+class ModelGateReport:
+    status: str
+    required_segments: list[str]
+    passed_segments: list[str]
+    failed_segments: list[str]
+    inconclusive_segments: list[str]
+    comparisons: list[dict[str, Any]]
+
+    def to_dict(self) -> dict[str, Any]:
+        return asdict(self)
+
+
+def _boosted_segment_rows(metrics: pd.DataFrame) -> pd.DataFrame:
+    if metrics is None or metrics.empty:
+        return pd.DataFrame()
+    frame = metrics.copy()
+    return frame[
+        frame["filter_view"].eq("all")
+        & frame["segment_type"].eq("competition_segment")
+        & frame["segment"].astype(str).str.startswith("boosted|")
+    ].copy()
+
+
+def evaluate_model_gate(
+    candidate_metrics: pd.DataFrame,
+    production_metrics: pd.DataFrame,
+    *,
+    required_segments: tuple[str, ...] = _REQUIRED_GATE_SEGMENTS,
+    minimum_segment_matches: int = 200,
+) -> ModelGateReport:
+    candidate = _boosted_segment_rows(candidate_metrics).set_index("segment")
+    production = _boosted_segment_rows(production_metrics).set_index("segment")
+    passed: list[str] = []
+    failed: list[str] = []
+    inconclusive: list[str] = []
+    comparisons: list[dict[str, Any]] = []
+    for segment in required_segments:
+        key = f"boosted|{segment}"
+        if key not in candidate.index or key not in production.index:
+            inconclusive.append(segment)
+            comparisons.append({"segment": segment, "status": "INCONCLUSIVE", "reason": "missing candidate or production metrics"})
+            continue
+        cand = candidate.loc[key]
+        prod = production.loc[key]
+        if int(cand["matches"]) < int(minimum_segment_matches) or int(prod["matches"]) < int(minimum_segment_matches):
+            inconclusive.append(segment)
+            comparisons.append({
+                "segment": segment,
+                "status": "INCONCLUSIVE",
+                "reason": f"fewer than {minimum_segment_matches} walk-forward matches",
+                "candidate_matches": int(cand["matches"]),
+                "production_matches": int(prod["matches"]),
+            })
+            continue
+        better_log_loss = float(cand["log_loss"]) < float(prod["log_loss"])
+        better_calibration = float(cand["ece"]) <= float(prod["ece"])
+        status = "PASS" if better_log_loss and better_calibration else "FAIL"
+        (passed if status == "PASS" else failed).append(segment)
+        comparisons.append({
+            "segment": segment,
+            "status": status,
+            "candidate_matches": int(cand["matches"]),
+            "production_matches": int(prod["matches"]),
+            "candidate_log_loss": float(cand["log_loss"]),
+            "production_log_loss": float(prod["log_loss"]),
+            "candidate_ece": float(cand["ece"]),
+            "production_ece": float(prod["ece"]),
+        })
+    if failed:
+        overall = "FAIL"
+    elif inconclusive:
+        overall = "INCONCLUSIVE"
+    else:
+        overall = "PASS"
+    return ModelGateReport(
+        status=overall,
+        required_segments=list(required_segments),
+        passed_segments=passed,
+        failed_segments=failed,
+        inconclusive_segments=inconclusive,
+        comparisons=comparisons,
+    )
+
+
+@dataclass(slots=True)
+class CandidateBuildReport:
+    matches_path: str
+    features_path: str
+    predictions_path: str
+    metrics_path: str
+    calibration_path: str
+    candidate_model_path: str
+    unresolved_path: str
+    assembly: dict[str, Any]
+    model_gate: dict[str, Any]
+    promoted: bool
+
+    def to_dict(self) -> dict[str, Any]:
+        return asdict(self)
+
+
+def build_candidate_model(
+    config: AppConfig,
+    *,
+    api_matches_path: str | Path,
+    existing_matches_path: str | Path | None,
+    start_date: object,
+    end_date: object | None,
+    output_dir: str | Path,
+    identity_database_path: str | Path,
+    production_predictions_path: str | Path | None = None,
+    production_model_path: str | Path | None = None,
+    promote_if_passed: bool = False,
+) -> CandidateBuildReport:
+    output = Path(output_dir)
+    output.mkdir(parents=True, exist_ok=True)
+    identity_store = IdentityStore(identity_database_path)
+    sources: list[tuple[pd.DataFrame, str]] = []
+    api_path = Path(api_matches_path)
+    if not api_path.exists():
+        raise FileNotFoundError(api_path)
+    sources.append((pd.read_parquet(api_path), "api_tennis"))
+    if existing_matches_path:
+        existing_path = Path(existing_matches_path)
+        if existing_path.exists():
+            sources.append((pd.read_parquet(existing_path), "sackmann"))
+
+    assembler = MultiSourceMatchAssembler(
+        identity_store,
+        fuzzy_threshold=getattr(config.history, "fuzzy_match_threshold", 96.0),
+    )
+    matches, unresolved, assembly_report = assembler.assemble(
+        sources,
+        start_date=start_date,
+        end_date=end_date,
+    )
+    if matches.empty:
+        raise RuntimeError("No canonical matches remained after identity resolution.")
+
+    snapshot_frames: list[pd.DataFrame] = []
+    if config.odds.normalized_snapshots_path and Path(config.odds.normalized_snapshots_path).exists():
+        snapshot_frames.append(load_normalized_snapshots(config.odds.normalized_snapshots_path))
+    tennis_data_directory = getattr(config.history, "tennis_data_directory", None)
+    tennis_data_snapshot_path = Path(
+        getattr(config.history, "tennis_data_snapshots_path", "data/normalized/tennis_data_odds.parquet")
+    )
+    if tennis_data_directory and Path(tennis_data_directory).exists():
+        tennis_data, tennis_data_report = TennisDataLoader(tennis_data_directory).load()
+        if not tennis_data.empty:
+            tennis_data_snapshot_path.parent.mkdir(parents=True, exist_ok=True)
+            tennis_data.to_parquet(tennis_data_snapshot_path, index=False)
+            snapshot_frames.append(tennis_data)
+        (output / "tennis_data_report.json").write_text(
+            json.dumps(asdict(tennis_data_report), indent=2), encoding="utf-8"
+        )
+    elif tennis_data_snapshot_path.exists():
+        snapshot_frames.append(pd.read_parquet(tennis_data_snapshot_path))
+
+    if snapshot_frames:
+        snapshots = pd.concat(snapshot_frames, ignore_index=True)
+        for column in ("snapshot_time", "commence_time"):
+            snapshots[column] = pd.to_datetime(snapshots[column], errors="coerce")
+        matches, aligned = OddsAligner().align(matches, snapshots)
+        if not aligned.empty:
+            aligned.to_parquet(output / "aligned_odds.parquet", index=False)
+
+    matches = FilterEngine(config.filters).add_static_flags(matches)
+    engineer = FeatureEngineer(config.features, config.filters)
+    features = engineer.transform(matches, reset=True)
+    backtester = WalkForwardBacktester(config.model, config.backtest)
+    predictions, metrics = backtester.run(features)
+    calibration = calibration_curve_table(predictions)
+
+    matches_path = output / "matches_full.parquet"
+    features_path = output / "features_full.parquet"
+    predictions_path = output / "predictions.parquet"
+    metrics_path = output / "metrics.csv"
+    calibration_path = output / "calibration_curves.csv"
+    unresolved_path = output / "identity_unresolved.parquet"
+    candidate_model_path = output / "trained_system_candidate.joblib"
+
+    matches.to_parquet(matches_path, index=False)
+    features.to_parquet(features_path, index=False)
+    predictions.to_parquet(predictions_path, index=False)
+    metrics.to_csv(metrics_path, index=False)
+    calibration.to_csv(calibration_path, index=False)
+    unresolved.to_parquet(unresolved_path, index=False)
+    TennisPredictionSystem(config).fit(matches).save(candidate_model_path)
+
+    if production_predictions_path and Path(production_predictions_path).exists():
+        production_predictions = pd.read_parquet(production_predictions_path)
+        if "competition_segment" not in production_predictions:
+            production_predictions["competition_segment"] = derive_competition_segment(production_predictions)
+        production_metrics = evaluate_predictions(
+            production_predictions,
+            bootstrap_samples=config.backtest.bootstrap_samples,
+            random_state=config.backtest.random_state,
+        )
+    else:
+        production_metrics = pd.DataFrame()
+    gate = evaluate_model_gate(
+        metrics,
+        production_metrics,
+        minimum_segment_matches=getattr(config.history, "minimum_gate_segment_matches", 200),
+    )
+    (output / "promotion_gate.json").write_text(
+        json.dumps(gate.to_dict(), indent=2), encoding="utf-8"
+    )
+    (output / "assembly_report.json").write_text(
+        json.dumps(assembly_report.to_dict(), indent=2), encoding="utf-8"
+    )
+
+    promoted = False
+    if promote_if_passed:
+        if gate.status != "PASS":
+            raise RuntimeError(
+                f"Candidate was not promoted because the model gate status is {gate.status}."
+            )
+        if not production_model_path:
+            raise ValueError("production_model_path is required for promotion")
+        production = Path(production_model_path)
+        production.parent.mkdir(parents=True, exist_ok=True)
+        if production.exists():
+            backup = production.with_suffix(production.suffix + ".pre_candidate_backup")
+            shutil.copy2(production, backup)
+        shutil.copy2(candidate_model_path, production)
+        promoted = True
+
+    return CandidateBuildReport(
+        matches_path=str(matches_path),
+        features_path=str(features_path),
+        predictions_path=str(predictions_path),
+        metrics_path=str(metrics_path),
+        calibration_path=str(calibration_path),
+        candidate_model_path=str(candidate_model_path),
+        unresolved_path=str(unresolved_path),
+        assembly=assembly_report.to_dict(),
+        model_gate=gate.to_dict(),
+        promoted=promoted,
+    )
